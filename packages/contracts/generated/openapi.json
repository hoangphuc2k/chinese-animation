{
  "openapi": "3.1.0",
  "info": {
    "title": "Chinese Animation Localizer API",
    "version": "0.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "SourceState": {
        "type": "string",
        "enum": [
          "DISCOVERED",
          "TRANSLATING_METADATA",
          "INBOX_READY",
          "IGNORED",
          "IMPORT_SELECTED"
        ]
      },
      "ProcessingState": {
        "type": "string",
        "enum": [
          "QUEUED",
          "INGESTING",
          "PROBING",
          "EXTRACTING_AUDIO",
          "TRANSCRIBING",
          "OCR_OPTIONAL",
          "TRANSLATING",
          "WAITING_SCRIPT_REVIEW",
          "GENERATING_VOICE",
          "MIXING",
          "RENDERING",
          "READY_FOR_PREVIEW",
          "WAITING_PUBLISH_APPROVAL",
          "TIMING_REVIEW_REQUIRED",
          "MANUAL_REVIEW_REQUIRED",
          "COMPLETED",
          "FAILED",
          "CANCELLED",
          "EXPIRED",
          "RIGHTS_BLOCKED"
        ]
      },
      "DestinationState": {
        "type": "string",
        "enum": [
          "NOT_REQUESTED",
          "BLOCKED_BY_GATE",
          "READY_TO_UPLOAD",
          "UPLOAD_QUEUED",
          "UPLOADING",
          "PROCESSING",
          "STAGED_HIDDEN",
          "SCHEDULED",
          "PUBLISHED",
          "FAILED",
          "REJECTED",
          "MANUAL_ACTION_REQUIRED",
          "CANCELLED"
        ]
      },
      "CreateImportRequest": {
        "type": "object",
        "required": [
          "locator",
          "rightsEvidence"
        ],
        "additionalProperties": false
      },
      "ApproveScriptRequest": {
        "type": "object",
        "required": [
          "jobId",
          "scriptVersion",
          "contentHash"
        ],
        "additionalProperties": false
      },
      "ApprovePublishRequest": {
        "type": "object",
        "required": [
          "jobId",
          "renderId",
          "renderVersion",
          "metadataHash",
          "destinations",
          "scheduleAtUtc",
          "metadata"
        ],
        "additionalProperties": false
      },
      "ClaimJobResponse": {
        "type": "object",
        "required": [
          "jobId",
          "jobType",
          "jobVersion",
          "state",
          "leaseToken",
          "leaseExpiresAtUtc",
          "requestId"
        ],
        "properties": {
          "importInput": {
            "$ref": "#/components/schemas/ImportInput"
          },
          "ingestResult": {
            "$ref": "#/components/schemas/IngestResult"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "jobType": {
            "type": "string",
            "enum": [
              "IMPORT",
              "DISCOVERY",
              "LOCALIZE",
              "RENDER",
              "PUBLISH",
              "DELETE_EXPIRED"
            ]
          },
          "jobVersion": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string"
          },
          "leaseToken": {
            "type": "string",
            "minLength": 32
          },
          "leaseExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "pipelineInput": {
            "$ref": "#/components/schemas/PipelineClaimInput"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "HeartbeatRequest": {
        "type": "object",
        "required": [
          "leaseToken",
          "jobVersion"
        ],
        "additionalProperties": false
      },
      "CompleteStepRequest": {
        "type": "object",
        "required": [
          "leaseToken",
          "jobVersion",
          "expectedState",
          "state",
          "step"
        ],
        "properties": {
          "leaseToken": {
            "type": "string",
            "minLength": 32
          },
          "jobVersion": {
            "type": "integer",
            "minimum": 1
          },
          "expectedState": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "outputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytesWritten": {
            "type": "integer",
            "minimum": 0
          },
          "ingestResult": {
            "$ref": "#/components/schemas/IngestResult"
          },
          "pipelineArtifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/PipelineArtifact"
            }
          },
          "segmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "additionalProperties": false
      },
      "DashboardInboxResponse": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "SegmentReviewResponse": {
        "type": "object",
        "required": [
          "jobId",
          "scriptVersion",
          "segments"
        ],
        "additionalProperties": false
      },
      "RenderReviewResponse": {
        "type": "object",
        "required": [
          "jobId",
          "renderId",
          "renderVersion",
          "checksum",
          "destinations",
          "previewUrl"
        ],
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ClaimJobRequest": {
        "type": "object",
        "required": [
          "supportedJobTypes",
          "supportedStates"
        ],
        "properties": {
          "supportedJobTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "IMPORT",
                "DISCOVERY",
                "LOCALIZE",
                "RENDER",
                "PUBLISH",
                "DELETE_EXPIRED"
              ]
            }
          },
          "supportedStates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 21,
            "items": {
              "$ref": "#/components/schemas/ProcessingState"
            }
          }
        },
        "additionalProperties": false
      },
      "ImportInput": {
        "type": "object",
        "required": [
          "locator",
          "rightsEvidenceHash",
          "sourceAssetId"
        ],
        "properties": {
          "locator": {
            "$ref": "#/components/schemas/IngestLocator"
          },
          "rightsEvidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceAssetId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "TechnicalMetadata": {
        "type": "object",
        "required": [
          "durationSeconds",
          "formatName",
          "hasAudio",
          "hasVideo"
        ],
        "properties": {
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "formatName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "hasAudio": {
            "type": "boolean"
          },
          "hasVideo": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "IngestResult": {
        "type": "object",
        "required": [
          "normalizedByteCount",
          "normalizedHash",
          "sourceByteCount",
          "sourceHash",
          "technicalMetadata"
        ],
        "properties": {
          "normalizedByteCount": {
            "type": "integer",
            "minimum": 0
          },
          "normalizedHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceByteCount": {
            "type": "integer",
            "minimum": 0
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "technicalMetadata": {
            "$ref": "#/components/schemas/TechnicalMetadata"
          }
        },
        "additionalProperties": false
      },
      "PipelineArtifact": {
        "type": "object",
        "required": [
          "artifactRef",
          "byteCount",
          "kind",
          "sha256",
          "toolVersion"
        ],
        "properties": {
          "artifactRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "byteCount": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "EXTRACTED_AUDIO",
              "MIXED_AUDIO",
              "NORMALIZED_MEDIA",
              "OCR_TRACK",
              "RENDER",
              "SCRIPT",
              "SUBTITLES",
              "TRANSCRIPT",
              "VOICE"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "toolVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "additionalProperties": false
      },
      "PipelineClaimInput": {
        "type": "object",
        "required": [
          "normalizedMedia"
        ],
        "properties": {
          "normalizedMedia": {
            "$ref": "#/components/schemas/PipelineArtifact"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
