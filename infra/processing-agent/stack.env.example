# Copy into the Portainer stack's "Environment variables" (or load this file there).
# Never commit real values. Secrets here live only in Portainer until OCI Vault wiring lands.

# Image
REGISTRY=registry.example.com/localizer
AGENT_IMAGE_TAG=sha-0000000

# Host directory that holds workspaces/, inbox/, models/ and assets/ (owned by 10001:10001)
LOCALIZER_DATA_ROOT=/mnt/localizer

# Control plane: the Access-protected agent API hostname that routes to the Worker
CONTROL_PLANE_URL=https://agent-api.example.com
AGENT_ACCESS_CLIENT_ID=replace-me.access
AGENT_ACCESS_CLIENT_SECRET=replace-me

# Transcription (required)
WHISPER_MODEL_FILE=ggml-small-q5_1.bin
WHISPER_MODEL_SHA256=replace-with-lowercase-sha256

# Rendering (required)
WATERMARK_FILE=watermark.png
WATERMARK_SHA256=replace-with-lowercase-sha256

# Translation (optional: set all three or none; base URL is
# https://generativelanguage.googleapis.com/v1beta)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL_ID=

# Voice (optional: set all three or none)
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_VOICE=

# Resource limits
AGENT_CPUS=2
AGENT_MEMORY_LIMIT=10g
