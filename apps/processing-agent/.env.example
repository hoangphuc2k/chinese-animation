CONTROL_PLANE_URL=https://control-plane.example.com
AGENT_ACCESS_CLIENT_ID=replace-with-Cloudflare-Access-service-token-client-id
AGENT_ACCESS_CLIENT_SECRET=replace-with-Cloudflare-Access-service-token-client-secret
WORKSPACE_ROOT=/var/lib/localizer-agent/workspace
INBOX_ROOT=/var/lib/localizer-agent/inbox
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=30
MAX_SOURCE_BYTES=21474836480
MINIMUM_FREE_BYTES=5368709120
WHISPER_BINARY_PATH=/opt/localizer/bin/whisper-cli
WHISPER_BINARY_VERSION=whisper.cpp-pinned
WHISPER_MODEL_PATH=/opt/localizer/models/ggml-small-q5_1.bin
WHISPER_MODEL_SHA256=replace-with-lowercase-model-sha256
GEMINI_API_KEY=replace-with-provider-secret
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_ID=gemini-2.5-flash
AZURE_SPEECH_ENDPOINT=https://eastus.tts.speech.microsoft.com/cognitiveservices/v1
AZURE_SPEECH_KEY=replace-with-provider-secret
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
WATERMARK_PATH=/opt/localizer/assets/watermark.png
WATERMARK_SHA256=replace-with-lowercase-watermark-sha256
